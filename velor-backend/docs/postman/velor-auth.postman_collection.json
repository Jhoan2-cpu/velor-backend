{
    "info": {
        "name": "Velor Backend — Auth",
        "_postman_id": "velor-auth-v1",
        "description": "Auth module: Register, Login, Logout, Me, Google OAuth",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Register",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/register",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "register"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    },
                    "raw": "{\n  \"display_name\": \"Anton Rivera\",\n  \"email\": \"anton@velor.app\",\n  \"password\": \"secret12345\",\n  \"password_confirmation\": \"secret12345\",\n  \"locale\": \"es\",\n  \"time_zone_name\": \"America/Lima\"\n}"
                }
            }
        },
        {
            "name": "Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const xsrf = pm.cookies.get('XSRF-TOKEN');",
                            "if (xsrf) pm.collectionVariables.set('xsrf_token', decodeURIComponent(xsrf));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "login"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    },
                    "raw": "{\n  \"email\": \"anton@velor.app\",\n  \"password\": \"secret12345\"\n}"
                }
            }
        },
        {
            "name": "Me",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/me",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "me"
                    ]
                }
            }
        },
        {
            "name": "Logout",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "X-XSRF-TOKEN",
                        "value": "{{xsrf_token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/logout",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "logout"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": ""
                }
            }
        },
        {
            "name": "Google — Redirect (abrir en browser)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/google/redirect",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "google",
                        "redirect"
                    ]
                }
            }
        }
    ]
}